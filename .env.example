# Copy to .env and fill in. Never commit .env.

# Shared secret between hub and proxy: openssl rand -hex 32
CONFIGPROXY_AUTH_TOKEN=

# Password all workshop participants use (min. 8 characters)
JUPYTERHUB_SHARED_PASSWORD=

# Optional: admin users (comma-separated) and their password (min. 32 characters)
JUPYTERHUB_ADMIN_USERS=admin
JUPYTERHUB_ADMIN_PASSWORD=

# JupyterLab image built by GitHub Actions. Use a fixed tag (a git tag or
# sha-<commit>), not latest: the hub does not re-pull an image it already has.
DOCKER_NOTEBOOK_IMAGE=ghcr.io/cloud-nes/jupyter-singleuser:<tag>

# Host directory holding the user homes (<dir>/<username>), on persistent
# storage. On SURF Research Cloud: /data/<storage-volume-name>/users
USER_STORAGE_DIR=/data/storage/users

# Host directory with workshop material, mounted read-only for all users at
# ~/shared. On SURF Research Cloud: /data/<storage-volume-name>/shared
SHARED_DIR=/data/storage/shared

# Resource limits per user
MEM_LIMIT=2G
CPU_LIMIT=1

# Stop user servers after this many seconds of inactivity
CULL_TIMEOUT=3600
